@* List<Book>型のデータを受け取りますよという宣言 *@
@model List<LibrarySystem1._0.Models.BookInfo>

@{
    ViewData["Title"] = "書籍一覧";
}

<h1>書籍一覧</h1>

<table class="table">
    <thead>
        <tr>
            <th>タイトル</th>
            <th>著者</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
            </tr>
        }
    </tbody>
</table>